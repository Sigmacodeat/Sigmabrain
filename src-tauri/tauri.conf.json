{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SigmaBrain",
  "version": "0.1.0",
  "identifier": "com.sigmabrain.desktop",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "DESKTOP_BUILD=1 bun run build",
    "frontendDist": "../out"
  },
  "app": {
    "windows": [
      {
        "title": "SigmaBrain",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "decorations": true,
        "transparent": false,
        "alwaysOnTop": false
      }
    ],
    "security": {
      "csp": null
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Productivity",
    "shortDescription": "SigmaBrain Desktop",
    "longDescription": "The brain your firm never had — now as a native desktop app.",
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "windows": {
      "wix": {
        "language": "en-US"
      }
    }
  },
  "plugins": {}
}
